        <mxCell id="boundary_note" value="Following requires:&#10;- a resident request&#10;- the selected person to be tracked&#10;- safety information from the robot&#10;&#10;If any are unavailable, request a stop.&#10;Physical stopping still needs testing." style="html=0;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=23.5;fontColor=#20313B;align=center;rounded=0;fillColor=#F7F9FA;strokeColor=#C9D2D7;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="560" width="435" height="260" />
        </mxCell>
        <mxCell id="timing" value="Targets: speed &lt;= 0.2 m/s; request zero within 1 s of loss; settle within 25 mm of the loss point.&#10;Within 10 s, speed stays below 5 mm/s for 1 s. Resident must request following again; call may continue.&#10;Physical stopping and fault behavior must be tested on the built robot." style="html=0;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=21.5;fontColor=#20313B;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="939" width="1530" height="75" />
        </mxCell>
        <mxCell id="legend" value="Blue rounded boxes: parts we build. Gray dashed boxes: outside services. Figures: people.&#10;Arrows show data direction; I1-I16 match the interface table. Red: wired Stop/Privacy. Gray dashed: human input/output.&#10;Dashed blue outlines: software location. Open-ended boxes: stored permissions or call history.&#10;Repeated robot-platform boxes show different connections to the same physical assembly." style="html=0;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=24.5;fontColor=#20313B;align=center;rounded=0;fillColor=#F7F9FA;strokeColor=#C9D2D7;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="1020" width="1530" height="125" />
        </mxCell>
