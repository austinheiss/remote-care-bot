        <mxCell id="scope" value="Inputs: call request, resident choices, sensor readings. Outputs: call, status and movement.&#10;Following stops on request or when tracking or a safety check fails. Physical stopping needs testing." style="html=0;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=22.5;fontColor=#20313B;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="850" width="1530" height="55" />
        </mxCell>
        <mxCell id="legend" value="Blue rounded boxes: parts we build. Gray dashed boxes: outside services. Figures: people.&#10;Arrows show data direction; I1-I16 match the interface table. Red: wired Stop/Privacy. Gray dashed: human input/output.&#10;Dashed blue outlines: software location. Open-ended boxes: stored permissions or call history.&#10;Repeated robot-platform boxes show different connections to the same physical assembly." style="html=0;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=24.5;fontColor=#20313B;align=center;rounded=0;fillColor=#F7F9FA;strokeColor=#C9D2D7;strokeWidth=1;" vertex="1" parent="1">
