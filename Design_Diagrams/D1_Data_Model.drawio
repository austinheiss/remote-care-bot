  <diagram name="Call server data model">
    <mxGraphModel page="1" pageWidth="1400" pageHeight="1620" grid="1" gridSize="10" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="In-Home Assistive Robot | Call server data model" style="html=0;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=34;fontColor=#20313B;align=center;fillColor=none;strokeColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="25" y="20" width="1350" height="55" />
        </mxCell>
        <mxCell id="goal" value="Goal: Our robot lets an older or disabled adult at home take video calls from a family caregiver and,&#10;if they want, have the robot follow them from room to room during the call. The robot stops following&#10;as soon as it loses track of them or a safety check fails." style="html=0;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=25;fontColor=#20313B;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="90" width="1310" height="120" />
        </mxCell>
        <mxCell id="robot" value="Robot&#10;PK  robot_id: text&#10;last_seen_utc: timestamp or none&#10;last_sequence: integer or none" style="html=0;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=28;fontColor=#20313B;align=center;rounded=1;fillColor=#EAF4FA;strokeColor=#126D9B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="280" width="520" height="205" />
        </mxCell>
        <mxCell id="caregiver" value="Caregiver&#10;PK  caregiver_id: text&#10;display_name: text" style="html=0;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=28;fontColor=#20313B;align=center;rounded=1;fillColor=#EAF4FA;strokeColor=#126D9B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="825" y="280" width="520" height="205" />
        </mxCell>
        <mxCell id="pairing" value="Pairing&#10;PK, FK  robot_id: text&#10;PK, FK  caregiver_id: text&#10;active: boolean" style="html=0;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=28;fontColor=#20313B;align=center;rounded=1;fillColor=#EAF4FA;strokeColor=#126D9B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="405" y="680" width="590" height="240" />
        </mxCell>
        <mxCell id="call" value="CallAttempt&#10;PK  call_id: UUID&#10;FK  (robot_id, caregiver_id) to Pairing: text&#10;UQ  request_id: UUID or none&#10;status: call status&#10;created_utc: timestamp&#10;accepted_utc, ended_utc: timestamp or none" style="html=0;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=28;fontColor=#20313B;align=center;rounded=1;fillColor=#EAF4FA;strokeColor=#126D9B;strokeWidth=2;" vertex="1" parent="1">
